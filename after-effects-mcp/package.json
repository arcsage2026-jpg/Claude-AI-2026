{
  "name": "after-effects-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that lets Claude drive Adobe After Effects (compositions, layers, render queue) through a companion CEP panel, for office motion-graphics and batch-render workflows.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "after-effects-mcp-server": "dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "npm run build && node test/mock-ae-smoke-test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
